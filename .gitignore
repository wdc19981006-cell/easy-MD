# Never commit molecular structures, sessions, trajectories or renderings.
# Case-insensitive checks in tools/repository_guard.py also inspect staged blobs.
*.[pP][dD][bB]
*.ent
*.[cC][iI][fF]
*.mmcif
*.bcif
*.mmtf
*.[pP][dD][bB][qQ][tT]
*.[sS][dD][fF]
*.[mM][oO][lL]
*.mol2
*.xyz
*.gro
*.crd
*.mae
*.maegz
*.[pP][sS][eE]
